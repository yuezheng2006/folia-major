pid /tmp/nginx.pid;
worker_processes auto;

events {
    worker_connections 2048;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format combined_no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /dev/stdout combined_no_query;
    error_log /dev/stderr warn;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 75;
    keepalive_requests 1000;
    client_max_body_size 4m;
    gzip on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/json application/javascript text/css text/plain application/xml image/svg+xml;

    # Defer upstream DNS to request time (Zeabur internal names may not resolve at boot).
    resolver ${FOLIA_DNS_RESOLVER} ipv6=off valid=10s;

    upstream folia_netease_upstream {
        zone folia_netease 64k;
        server ${FOLIA_NETEASE_UPSTREAM} resolve;
        keepalive 32;
        keepalive_timeout 60s;
    }

    upstream folia_kugou_upstream {
        zone folia_kugou 64k;
        server ${FOLIA_KUGOU_UPSTREAM} resolve;
        keepalive 32;
        keepalive_timeout 60s;
    }

    upstream folia_qq_upstream {
        zone folia_qq 64k;
        server ${FOLIA_QQ_UPSTREAM} resolve;
        keepalive 32;
        keepalive_timeout 60s;
    }

    upstream folia_api_upstream {
        zone folia_api 64k;
        server ${FOLIA_API_UPSTREAM} resolve;
        keepalive 8;
        keepalive_timeout 60s;
    }

    map $http_x_forwarded_proto $folia_forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    server {
        listen 8080;
        server_name _;
        root /usr/share/nginx/html;

        location = /healthz {
            access_log off;
            default_type application/json;
            return 200 '{"ok":true,"service":"folia-gateway"}';
        }

        location = /runtime-config.js {
            access_log off;
            default_type application/javascript;
            add_header Cache-Control "no-store";
            return 200 'window.__FOLIA_RUNTIME_CONFIG__={aiProvider:"${FOLIA_AI_PROVIDER}"};';
        }

        location ~* ^/assets/.+\.(js|css|woff2?)$ {
            expires 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
            try_files $uri =404;
        }

        # `set` must run before `rewrite ... break` (break skips later rewrite-module dirs).
        location /netease/ {
            rewrite ^/netease/?(.*)$ /$1 break;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://folia_netease_upstream;
            proxy_connect_timeout 3s;
            proxy_send_timeout 25s;
            proxy_read_timeout 25s;
            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
            proxy_buffer_size 32k;
            proxy_buffers 8 32k;
            proxy_busy_buffers_size 64k;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $folia_forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /kugou/ {
            rewrite ^/kugou/?(.*)$ /$1 break;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://folia_kugou_upstream;
            proxy_connect_timeout 3s;
            proxy_send_timeout 25s;
            proxy_read_timeout 25s;
            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $folia_forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /qq/ {
            rewrite ^/qq/?(.*)$ /$1 break;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://folia_qq_upstream;
            proxy_connect_timeout 3s;
            proxy_send_timeout 25s;
            proxy_read_timeout 25s;
            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $folia_forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://folia_api_upstream;
            proxy_connect_timeout 3s;
            proxy_send_timeout 25s;
            proxy_read_timeout 25s;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $folia_forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            try_files $uri $uri/ /index.html;
        }
    }
}
